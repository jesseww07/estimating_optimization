    {
      "id": "claim_d53e0746dd994e16be8bba17b5f73662",
      "statement": "wiki-publish.yml is intentionally split out from openwiki-update.yml rather than being a step inside it, because openwiki-update.yml's push trigger uses paths-ignore: openwiki/**, so merging a docs-only PR would never fire a publish step living there; splitting also keeps publishing cheap (seconds, no model calls, no dependency install) and independent of whether the ~20-minute OpenWiki agent run succeeded.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/wiki-publish.yml#L1-L13",
          "version": "repo-lines-v1:sha256:d57dc5efd91cc02bafb75399375524e9159221f7c79892be3e496542614b9075:"
