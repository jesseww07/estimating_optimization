    {
      "id": "claim_3d68f724940849e985391bf9c0a23738",
      "statement": "The openwiki-update.yml workflow runs `openwiki code --update --print` on push to main outside the openwiki/** path, on manual workflow_dispatch, and on a weekly Monday 08:00 UTC cron backstop ('0 8 * * 1') rather than a daily schedule — deliberately weekly because a run costs ~20 minutes and, until the resulting openwiki/update PR is merged, `.last-update.json` on main still points at the old head so every run regenerates the same pages from scratch, which would make a daily schedule scale cost with how long the PR sits unreviewed. It pushes changes to and opens/updates a PR against the openwiki/update branch, independent of the accuracy/typecheck/lint CI gate.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml",
          "version": "repo-file-v1:sha256:adf9be965f4344899a7fd51ec3f1e8c63d6cb1f50490e8d869a44ecb3a800fc0"
        }
      ]
    },
