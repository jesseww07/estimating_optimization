    {
      "id": "claim_3847ecbe346f4470b6c065b8e2565dd2",
      "statement": "fetchEngineContext fetches History, Premier Items, 3rd Party Items, and Fans sequentially rather than in parallel because Airtable caps a base at 5 requests/second and penalizes bursts with a 429 and a 30-second window; sequential fetching keeps the full ~130-request pull under that cap.",
      "evidence": [
        {
          "resource": "repo://lib/airtable/fetch.ts#L302-L313",
          "version": "repo-lines-v1:sha256:e5cbb3a47a70d4f5bbceabb937c40b53e443d2bc31e40114caef7fe0ed3493d9:"
