# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials — never commit
.env
.env.*
!.env.example
*.pat
.airtable_pat/
credentials*
secrets*
*.pem
*.jsonl

# agent worktrees (transient)
.claude/worktrees/
# generated Airtable hygiene worklist — contains bid item text, project names,
# and catalog Item IDs; this repo is public. Unanchored so an --out= override
# anywhere in the tree is still covered; the generator itself is exempted.
hygiene-report.*
!scripts/hygiene-report.ts

# full Airtable table backups taken before any bulk write — these are the whole
# customer catalog and bid history, and this repo is PUBLIC. Unanchored so an
# --out= override anywhere in the tree is still covered.
base-backup/
base-backup-*/
*.base-backup.json
