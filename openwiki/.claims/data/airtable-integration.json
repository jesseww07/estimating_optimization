      "id": "claim_67d79cd0d61446f598cbdc2a07249e2c",
      "statement": "All catalog and historical-decision data for the VE Estimator lives in one Airtable base (default appWj912AEOvtxqJF, overridable via AIRTABLE_BASE_ID), containing History, Premier Items, Fans, 3rd Party Domestic Items, Product Categories, and Manufacturers tables, each bound by pinned table ID in lib/airtable/schema.ts.",
      "evidence": [
        {
          "resource": "repo://lib/airtable/schema.ts#L22-L31",
          "version": "repo-lines-v1:sha256:40f7a7e4469be8cc32980ca8185832d86ab43d66c0ab3d73ff6f2a1874013473:"
        }
      ]
    },
    {
      "id": "claim_da89668796834a4a8d9ba0e1a56fbf2b",
      "statement": "A History row links to at most one of Premier Items (PREMIER_LINK) or 3rd Party Domestic Items (THIRD_PARTY_LINK), never both, per the schema's design contract.",
