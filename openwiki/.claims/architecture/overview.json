    {
      "id": "claim_2ccb7b4fce7e4fd0ae6bfa75fb5d6620",
      "statement": "POST /api/identify-batch accepts the whole uploaded sheet (optionally narrowed via an explicit rowIndexes selection) and delegates to lib/identify/batch.ts to decide which lines need a Claude call, skipping lines the engine already understands, RFI placeholders, and LED tape at zero cost, and chunking the rest under a hard call ceiling with no web-search turns.",
      "evidence": [
        {
          "resource": "repo://app/api/identify-batch/route.ts#L1-L41",
          "version": "repo-lines-v1:sha256:669c60b5172fdebdcbc31076deff04c9588f1cc3587523735ccaa3f77464bc16:"
        }
      ]
    },
    {
      "id": "claim_f569a8ab7499498980d5e37b0fbfe907",
      "statement": "POST /api/identify-batch amends rather than violates the per-line 'never sweep a whole sheet' cost guardrail because it is user-triggered by an explicit button press, bounded by a hard call ceiling, and re-analyzes and returns only the lines identification actually changed, preserving prior per-line identifications made by the estimator.",
      "evidence": [
        {
          "resource": "repo://app/api/identify-batch/route.ts#L131-L147",
          "version": "repo-lines-v1:sha256:653a88d0a01a2f22f9878aa2ff13476adffe9034b0c57249dd9c7abf6f66ba87:"
