    {
      "id": "claim_bf0c8aee2f854bf1b7d00c56bce80a63",
      "statement": "selectAll in lib/airtable/fetch.ts catches the 422 Airtable returns when a pinned field ID no longer exists on a table, parses the missing field ID out of the error message, drops just that field, logs the drop, and retries — bounded to at most one retry per originally requested field — so a missing field costs only that field's data rather than taking the whole table fetch offline (a prior production incident from a 2026-09-01 schema edit that removed Premier's Style and History's Spec Vendor fields).",
      "evidence": [
        {
          "resource": "repo://lib/airtable/fetch.ts#L97-L131",
          "version": "repo-lines-v1:sha256:a7e91949dd6da43b55d310328ac5dbdba122824552e145499e79c254981d4043:"
