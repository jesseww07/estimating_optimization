# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials (this repo is public).

# Personal access token for the Premier estimating Airtable base
# (appWj912AEOvtxqJF). Required for live data; without it the app falls
# back to fixtures/mocks where supported.
AIRTABLE_PAT=

# Overrides the default Airtable base ID. Optional — defaults to the
# production base (appWj912AEOvtxqJF) when unset.
AIRTABLE_BASE_ID=

# Claude API key, used for PDF fixture-schedule reading and per-line
# spec identification.
ANTHROPIC_API_KEY=

# Required ONLY for an identity-linked API key, which cannot make any request
# without naming the workspace it acts in — every Claude call fails with
# "400 anthropic-workspace-id is required..." until this is set. A
# workspace-scoped key needs no header, so leave this blank for one.
ANTHROPIC_WORKSPACE_ID=

# Overrides the Claude model used for identification. Optional.
IDENTIFY_MODEL=

# History write-back kill switch: live / dry_run / off.
# Unset defaults to `live` in production and `dry_run` everywhere else —
# leave unset locally unless you're deliberately testing write-back.
HISTORY_WRITEBACK=
