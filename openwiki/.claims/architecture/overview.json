    },
    {
      "id": "claim_a5f8a5d8e4ab48e0b09d8eb9d0319bbf",
      "statement": "POST /api/upload's Claude-read document path accepts PDFs, PNG/JPEG/WebP/GIF images, and Word (.docx) schedules up to 15 MB, detecting the type by sniffing file bytes (magic numbers / ZIP-directory inspection) rather than filename or browser-supplied MIME type, and is gated by isIdentifyAvailable() returning 503 when ANTHROPIC_API_KEY is unset.",
      "evidence": [
        {
          "resource": "repo://app/api/upload/route.ts#L184-L224",
          "version": "repo-lines-v1:sha256:ee1b2282132cbb0c4a16aa43443e9e9b517fa66243badea14b714c4d35c1e14c:"
        },
        {
