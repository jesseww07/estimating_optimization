    {
      "id": "claim_8510a21c6b3d4009b12babf88c8b0dce",
      "statement": "app/prepareUpload.ts is a deliberate exception to the lib/** framework-agnostic rule: it is browser-only (uses canvas/createImageBitmap) and therefore lives under app/, while the .docx reader it depends on (lib/parse/docx.ts) is isomorphic and shared with the API route.",
      "evidence": [
        {
          "resource": "repo://app/prepareUpload.ts#L1-L27",
          "version": "repo-lines-v1:sha256:80faea7aadd75d5fcc0fc7eacbb9792c6467066c01cc64114358c81387d39f84:"
        }
      ]
    },
    {
      "id": "claim_a032921a5f894c098d42ae3457b8835b",
      "statement": "POST /api/upload accepts either a single multipart 'file' field or a browser-prepared multi-page document sent as repeated 'page' fields with parallel 'pageLabel' fields plus optional 'docText' and 'fileName'.",
      "evidence": [
        {
          "resource": "repo://app/api/upload/route.ts#L1-L30",
          "version": "repo-lines-v1:sha256:cd6b24356cc67795f33e620c3d416a1c6fb12279e9582de0f512228f784d8667:"
